{# ── Tracking live search ────────────────────────────────────────────────── #}
<div class="card mb-4">
  <div class="card-header">
    <h3 class="mb-0">
      <i class="material-icons mr-1">track_changes</i>
      Ricerca Tracking in Tempo Reale
    </h3>
  </div>
  <div class="card-body">
    <div class="form-inline">
      <div class="form-group mr-2 mb-2">
        <label for="tracking-parcel-id" class="sr-only">Parcel ID</label>
        <input type="text" class="form-control" id="tracking-parcel-id" placeholder="Inserisci Parcel ID collo BRT...">
      </div>
      <button type="button" class="btn btn-primary mb-2 mr-2" id="btn-do-tracking">
        <i class="material-icons">search</i> Traccia Spedizione
      </button>
      <div id="tracking-spinner" class="mb-2" style="display:none;">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
      </div>
    </div>
    <div id="tracking-result-container" style="display:none;" class="mt-3">
      <div id="tracking-result-content"></div>
    </div>
  </div>
</div>

{# ── Storico tracking ─────────────────────────────────────────────────────── #}
<div class="card">
  <div class="card-header">
    <h3 class="mb-0">
      <i class="material-icons mr-1">history</i>
      Storico Tracking (Ultimi 50 record)
    </h3>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped table-hover mb-0">
        <thead class="thead-light">
          <tr>
            <th>#</th>
            <th>Ordine</th>
            <th>Parcel ID</th>
            <th>Rif. Numerico</th>
            <th>Stato</th>
            <th>Data Consegna</th>
            <th>Firmatario</th>
            <th>Esito</th>
            <th>Aggiornato</th>
            <th class="text-right">Azioni</th>
          </tr>
        </thead>
        <tbody>
          {% if tab_tracking %}
            {% for trk in tab_tracking %}
              <tr>
                <td>{{ trk.id_brt_restapi_tracking }}</td>
                <td>
                  {% if trk.id_order %}
                    <a href="{{ admin_url_orders }}&id_order={{ trk.id_order }}&vieworder" target="_blank" class="font-weight-bold">
                      #{{ trk.id_order }}
                    </a>
                  {% else %}
                    <span class="text-muted">—</span>
                  {% endif %}
                </td>
                <td><code>{{ trk.parcel_id|e }}</code></td>
                <td>{{ trk.numeric_sender_reference }}</td>
                <td title="{{ trk.stato_spedizione|e }}">{{ trk.stato_spedizione|e }}</td>
                <td>{{ trk.data_consegna ? trk.data_consegna : '—' }}</td>
                <td>{{ trk.firmatario|e ?: '—' }}</td>
                <td>
                  {% if trk.esito == 1 %}
                    <span class="badge badge-success"><i class="material-icons" style="font-size:12px">done_all</i> Consegnato</span>
                  {% elseif trk.esito == 0 %}
                    <span class="badge badge-info"><i class="material-icons" style="font-size:12px">local_shipping</i> In transito</span>
                  {% elseif trk.esito == -1 %}
                    <span class="badge badge-danger"><i class="material-icons" style="font-size:12px">error</i> Errore</span>
                  {% else %}
                    <span class="badge badge-warning">{{ trk.esito }}</span>
                  {% endif %}
                </td>
                <td><small class="text-muted">{{ trk.date_upd }}</small></td>
                <td class="text-right">
                  <button class="btn btn-outline-info btn-sm btn-retrack" data-parcel="{{ trk.parcel_id|e }}" data-order="{{ trk.id_order }}" data-numeric="{{ trk.numeric_sender_reference }}" title="Aggiorna tracking">
                    <i class="material-icons">refresh</i>
                  </button>
                  <button class="btn btn-outline-secondary btn-sm btn-view-tracking" data-parcel="{{ trk.parcel_id|e }}" title="Visualizza dettaglio">
                    <i class="material-icons">visibility</i>
                  </button>
                </td>
              </tr>
            {% endfor %}
          {% else %}
            <tr>
              <td colspan="10" class="text-center py-4 text-muted">
                <i class="material-icons d-block mb-1" style="font-size:32px">track_changes</i>
                Nessun record di tracking trovato.
              </td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>
</div>
