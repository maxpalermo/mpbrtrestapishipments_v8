{% set stat_order = ['delivered', 'fermopoint', 'transit', 'rejected', 'waiting', 'alerts'] %}
{% set filter_query = '' %}
{% for key, value in history_filters %}
  {% set filter_query = filter_query ~ '&filter_' ~ key ~ '=' ~ value|url_encode %}
{% endfor %}

<div class="brt-stats">
  {# Summary cards #}
  <div class="row mb-4">
    {% for key in stat_order %}
      {% set s = stats[key] %}
      <div class="col-md-2 col-sm-4 col-6 mb-3 mb-md-0">
        <div class="card h-100 text-center">
          <div class="card-body p-3">
            <i class="material-icons d-block mb-1 text-primary" style="font-size:28px;">{{ s.icon }}</i>
            <h4 class="font-weight-bold mb-1">{{ s.count }}</h4>
            <div class="small text-muted">{{ s.label }}</div>
            <span class="badge badge-secondary mt-1">{{ s.percent }}%</span>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {# Charts #}
  <div class="row mb-4">
    <div class="col-md-4 mb-3 mb-md-0">
      <div class="card h-100">
        <h3 class="card-header">Massimo Giorni Consegna</h3>
        <div class="card-body text-center" style="height:200px;position:relative;">
          <canvas id="chartMaxDays"></canvas>
          <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;font-size:16px;">{{ delivery_days.max }} gg</div>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3 mb-md-0">
      <div class="card h-100">
        <h3 class="card-header">Minimo Giorni Consegna</h3>
        <div class="card-body text-center" style="height:200px;position:relative;">
          <canvas id="chartMinDays"></canvas>
          <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;font-size:16px;">{{ delivery_days.min }} gg</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <h3 class="card-header">Consegne per Mese</h3>
        <div class="card-body" style="height:200px;">
          <canvas id="chartByMonth"></canvas>
        </div>
      </div>
    </div>
  </div>

  {# History table #}
  <div class="card">
    <h3 class="card-header">Storico Consegne</h3>
    <div class="card-body p-0">
      <form method="get" action="{{ admin_url }}" class="mb-0">
        <input type="hidden" name="tab" value="stats">
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0">
            <thead class="thead-light">
              <tr>
                <th>Ordine</th>
                <th>Stato Ordine</th>
                <th>Data Spedizione</th>
                <th>Data Consegna</th>
                <th>Giorni</th>
                <th>Evento</th>
                <th>Nome Evento</th>
                <th>Data Evento</th>
                <th>Filiale</th>
                <th>Nome Filiale</th>
                <th>ID Collo</th>
                <th>RMA</th>
                <th class="text-right">Azioni</th>
              </tr>
              <tr>
                <th><input type="number" name="filter_id_order" class="form-control form-control-sm" placeholder="Ordine" value="{{ history_filters.id_order ?? '' }}"></th>
                <th><input type="text" name="filter_order_state" class="form-control form-control-sm" placeholder="Stato" value="{{ history_filters.order_state ?? '' }}"></th>
                <th></th>
                <th>
                  <div class="d-flex" style="gap:4px;">
                    <input type="date" name="filter_data_consegna_from" class="form-control form-control-sm" value="{{ history_filters.data_consegna_from ?? '' }}">
                    <input type="date" name="filter_data_consegna_to" class="form-control form-control-sm" value="{{ history_filters.data_consegna_to ?? '' }}">
                  </div>
                </th>
                <th></th>
                <th><input type="text" name="filter_event_code" class="form-control form-control-sm" placeholder="Codice" value="{{ history_filters.event_code ?? '' }}"></th>
                <th><input type="text" name="filter_event_name" class="form-control form-control-sm" placeholder="Nome" value="{{ history_filters.event_name ?? '' }}"></th>
                <th><input type="date" name="filter_event_date" class="form-control form-control-sm" value="{{ history_filters.event_date ?? '' }}"></th>
                <th><input type="text" name="filter_filiale" class="form-control form-control-sm" placeholder="Filiale" value="{{ history_filters.filiale ?? '' }}"></th>
                <th><input type="text" name="filter_nome_filiale" class="form-control form-control-sm" placeholder="Nome" value="{{ history_filters.nome_filiale ?? '' }}"></th>
                <th><input type="text" name="filter_parcel_id" class="form-control form-control-sm" placeholder="ID Collo" value="{{ history_filters.parcel_id ?? '' }}"></th>
                <th></th>
                <th class="text-right">
                  <button type="submit" class="btn btn-primary btn-sm" title="Filtra">
                    <i class="material-icons">filter_alt</i>
                  </button>
                  <a href="{{ admin_url }}&tab=stats" class="btn btn-secondary btn-sm" title="Reset">
                    <i class="material-icons">clear</i>
                  </a>
                </th>
              </tr>
            </thead>
            <tbody>
              {% for row in history %}
                <tr>
                  <td>
                    {% if row.id_order %}
                      <a href="{{ admin_url_orders }}&vieworder&id_order={{ row.id_order }}" target="_blank" class="font-weight-bold">#{{ row.id_order }}</a>
                    {% else %}
                      —
                    {% endif %}
                  </td>
                  <td>{{ row.order_state_name }}</td>
                  <td>{{ row.shipment_date ? row.shipment_date|date('d/m/Y') : '—' }}</td>
                  <td>{{ row.data_consegna and row.data_consegna != '0000-00-00' ? row.data_consegna|date('d/m/Y') : '—' }}</td>
                  <td>{{ row.giorni }}</td>
                  <td>{{ row.last_event.event_code }}</td>
                  <td>{{ row.last_event.event_name }}</td>
                  <td>{{ row.last_event.event_date }}</td>
                  <td>{{ row.last_event.filiale }}</td>
                  <td>{{ row.last_event.nome_filiale }}</td>
                  <td><code>{{ row.parcel_id }}</code></td>
                  <td>{{ row.last_event.rma }}</td>
                  <td class="text-right">
                    <button type="button" class="btn btn-outline-info btn-sm btn-retrack" data-parcel="{{ row.parcel_id }}" data-order="{{ row.id_order }}" data-numeric="{{ row.numeric_sender_reference }}" title="Aggiorna tracking">
                      <i class="material-icons">refresh</i>
                    </button>
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="13" class="text-center py-4 text-muted">Nessun dato di storico disponibile.</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </form>
    </div>
    {% if history_total_pages > 1 %}
      <div class="card-footer d-flex justify-content-between align-items-center">
        <span class="text-muted small">{{ history_total }} risultati — Pagina {{ history_current_page }} di {{ history_total_pages }}</span>
        <div class="btn-group">
          {% if history_current_page > 1 %}
            <a class="btn btn-outline-secondary btn-sm" href="{{ admin_url }}&tab=stats&stats_offset={{ (history_current_page - 2) * history_limit }}&stats_limit={{ history_limit }}{{ filter_query|raw }}">
              <i class="material-icons">chevron_left</i>
            </a>
          {% endif %}
          {% if history_current_page < history_total_pages %}
            <a class="btn btn-outline-secondary btn-sm" href="{{ admin_url }}&tab=stats&stats_offset={{ history_current_page * history_limit }}&stats_limit={{ history_limit }}{{ filter_query|raw }}">
              <i class="material-icons">chevron_right</i>
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% if stats.total is defined %}
<script>
  window.brtStatsData = {{ {stats: stats, delivery_days: delivery_days, delivered_by_month: delivered_by_month}|json_encode|raw }};
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function () {
  const chartColors = {
    green: '#28a745',
    blue: '#007bff',
    amber: '#ffc107',
    red: '#dc3545',
    gray: '#e9ecef',
  };

  const data = window.brtStatsData || {};
  const deliveryDays = data.delivery_days || { total: 0, count_at_max: 0, count_at_min: 0 };
  const maxTotal = deliveryDays.total;
  const minTotal = deliveryDays.total;
  const maxCount = deliveryDays.count_at_max;
  const minCount = deliveryDays.count_at_min;
  const deliveredByMonth = data.delivered_by_month || { labels: [], values: [] };
  const monthLabels = deliveredByMonth.labels;
  const monthValues = deliveredByMonth.values;

  const commonDoughnutOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } },
    cutout: '70%',
  };

  if (maxTotal > 0) {
    new Chart(document.getElementById('chartMaxDays'), {
      type: 'doughnut',
      data: {
        labels: ['CONSEGNATA', 'Altre'],
        datasets: [{
          data: [maxCount, maxTotal - maxCount],
          backgroundColor: [chartColors.green, chartColors.gray],
          borderWidth: 0,
        }]
      },
      options: commonDoughnutOptions,
    });
  }

  if (minTotal > 0) {
    new Chart(document.getElementById('chartMinDays'), {
      type: 'doughnut',
      data: {
        labels: ['CONSEGNATA', 'Altre'],
        datasets: [{
          data: [minCount, minTotal - minCount],
          backgroundColor: [chartColors.green, chartColors.gray],
          borderWidth: 0,
        }]
      },
      options: commonDoughnutOptions,
    });
  }

  if (monthLabels.length > 0) {
    new Chart(document.getElementById('chartByMonth'), {
      type: 'bar',
      data: {
        labels: monthLabels,
        datasets: [{
          label: 'Consegne',
          data: monthValues,
          backgroundColor: chartColors.blue,
          borderRadius: 4,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, ticks: { precision: 0 } },
          x: {},
        },
      },
    });
  }
})();
</script>
{% endif %}
